# ==============================================================================
# VERITAS Environment Variables (Example Template)
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME=VERITAS
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ENCRYPTION_MASTER_KEY=01234567890123456789012345678901  # 32-byte key for AES-256-GCM
# CORS Origins: explicit origins allowed for cross-origin access.
# In development (ENVIRONMENT=development), localhost, 127.0.0.1, and private RFC-1918 LAN IPs (10.x, 192.168.x, 172.16-31.x) are automatically allowed via CORS regex.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_USER=veritas_user
POSTGRES_PASSWORD=veritas_dev_password
POSTGRES_DB=veritas_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://veritas_user:veritas_dev_password@localhost:5432/veritas_db

# Redis & ARQ Background Worker Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Authentication & JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini API (Configured Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# PayPal Developer Platform (Sandbox)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id
PAYPAL_RECEIVER_ACCOUNT=merchant_sandbox@example.com
MOCK_PAYPAL=true

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
WHATSAPP_VERIFY_TOKEN=veritas_verify_token_dev
MOCK_WHATSAPP=true

# Frontend Configuration (for Vite)
# Default same-origin relative path works with Vite dev proxy on both localhost and LAN IP
VITE_API_BASE_URL=/api/v1

